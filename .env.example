# Credenciais do INLABS (cadastro gratuito em https://inlabs.in.gov.br/)
INLABS_EMAIL=seu-email@exemplo.com
INLABS_SENHA=sua-senha

# Onde o `fetch` grava os ZIPs do DOU. Opcional: sem isto, ele grava no
# diretório de onde foi rodado.
# INLABS_OUTPUT_DIR=data/bronze/inlabs

# Postgres local (subido pelo docker compose)
POSTGRES_USER=conselhos
POSTGRES_PASSWORD=conselhos
POSTGRES_DB=conselhos_vivos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
